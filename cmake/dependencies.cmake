include(FetchContent)
function(syrnck_archive name)
  file(READ "${CMAKE_CURRENT_FUNCTION_LIST_DIR}/dependencies.json" manifest)
  string(JSON manifest_version GET "${manifest}" version)
  if(NOT manifest_version STREQUAL "1")
    message(FATAL_ERROR "Unsupported dependency manifest")
  endif()
  string(JSON url GET "${manifest}" "${name}" url)
  string(JSON sha GET "${manifest}" "${name}" sha256)
  get_filename_component(filename "${url}" NAME)
  if(EXISTS "${PROJECT_SOURCE_DIR}/.tools/downloads/${filename}")
    set(url "${PROJECT_SOURCE_DIR}/.tools/downloads/${filename}")
  endif()
  FetchContent_Declare(${name} URL "${url}" URL_HASH "SHA256=${sha}" ${ARGN})
endfunction()
set(ZSTD_BUILD_PROGRAMS OFF CACHE BOOL "" FORCE)
set(ZSTD_BUILD_TESTS OFF CACHE BOOL "" FORCE)
set(ZSTD_BUILD_SHARED OFF CACHE BOOL "" FORCE)
set(ZSTD_BUILD_STATIC ON CACHE BOOL "" FORCE)
syrnck_archive(zstd SOURCE_SUBDIR build/cmake)
FetchContent_MakeAvailable(zstd)
if(NOT SYRNCK_BUILD_NETWORK)
