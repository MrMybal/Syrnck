include(FetchContent)
function(syrnck_archive name url sha)
  get_filename_component(filename "${url}" NAME)
  if(EXISTS "${PROJECT_SOURCE_DIR}/.tools/downloads/${filename}")
    set(url "${PROJECT_SOURCE_DIR}/.tools/downloads/${filename}")
  endif()
  FetchContent_Declare(${name} URL "${url}" URL_HASH "SHA256=${sha}" ${ARGN})
endfunction()
