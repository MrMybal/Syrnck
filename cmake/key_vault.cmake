set(SYRNCK_SYSTEM_KEY_VAULT "AUTO" CACHE STRING "System key vault support: AUTO, ON or OFF")
set_property(CACHE SYRNCK_SYSTEM_KEY_VAULT PROPERTY STRINGS AUTO ON OFF)
if(NOT SYRNCK_SYSTEM_KEY_VAULT MATCHES "^(AUTO|ON|OFF)$")
  message(FATAL_ERROR "SYRNCK_SYSTEM_KEY_VAULT must be AUTO, ON or OFF")
endif()
set(SYRNCK_VAULT_BACKEND unavailable)
set(SYRNCK_VAULT_LIBSECRET OFF)
set(SYRNCK_VAULT_EXTENSION cpp)
if(NOT SYRNCK_SYSTEM_KEY_VAULT STREQUAL "OFF")
  if(WIN32)
    set(SYRNCK_VAULT_BACKEND windows)
    target_link_libraries(syrnck_core PRIVATE advapi32)
  elseif(APPLE)
    enable_language(OBJCXX)
    set(SYRNCK_VAULT_BACKEND macos)
    set(SYRNCK_VAULT_EXTENSION mm)
    set_target_properties(syrnck_core PROPERTIES OBJCXX_STANDARD 20 OBJCXX_STANDARD_REQUIRED YES OBJCXX_EXTENSIONS NO)
    target_compile_options(syrnck_core PRIVATE "$<$<COMPILE_LANGUAGE:OBJCXX>:-fobjc-arc>")
    target_link_libraries(syrnck_core PRIVATE "-framework Security" "-framework CoreFoundation" "-framework LocalAuthentication" objc)
  elseif(CMAKE_SYSTEM_NAME STREQUAL "Linux")
    find_package(PkgConfig QUIET)
    if(PkgConfig_FOUND)
      pkg_check_modules(SYRNCK_LIBSECRET QUIET IMPORTED_TARGET libsecret-1>=0.18)
      if(SYRNCK_LIBSECRET_FOUND)
        set(SYRNCK_VAULT_BACKEND linux)
        set(SYRNCK_VAULT_LIBSECRET ON)
        target_link_libraries(syrnck_core PRIVATE PkgConfig::SYRNCK_LIBSECRET)
      endif()
    endif()
  endif()
endif()
if(SYRNCK_SYSTEM_KEY_VAULT STREQUAL "ON" AND SYRNCK_VAULT_BACKEND STREQUAL "unavailable")
  message(FATAL_ERROR "System key vault support was requested but no provider is available (Linux requires libsecret-1 development files)")
endif()
target_sources(syrnck_core PRIVATE src/key_vault.cpp "src/key_vault_${SYRNCK_VAULT_BACKEND}.${SYRNCK_VAULT_EXTENSION}")
message(STATUS "System key vault provider: ${SYRNCK_VAULT_BACKEND}")
